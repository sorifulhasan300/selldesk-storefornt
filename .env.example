# Centralized Backend API (Public & Internal)
NEXT_PUBLIC_API_URL=http://api.selldesk.test:5000/api/v1
# Configure only the exact trusted admin origin(s) for this deployment.
# Development: include the exact origin serving the admin, for example:
# http://app.selldesk.test:3000,http://localhost:3000
# Production: https://app.selldesk.com
NEXT_PUBLIC_BUILDER_ORIGINS=http://app.selldesk.test:3000,http://localhost:3000
INTERNAL_API_URL=http://localhost:5000/api/v1

# Multi-Tenant Base Domain (Used by Edge Middleware)
NEXT_PUBLIC_BASE_DOMAIN=selldesk.test:3001

# ISR Revalidation Secret
REVALIDATION_SECRET=selldesk_secure_isr_secret_2026
